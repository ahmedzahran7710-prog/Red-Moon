# Preserve the imported upstream snapshot byte-for-byte, including CRLF and BOMs.
vendor/FoxConquer5517/** -text
# Preserve the standalone imported CanyonV6192 snapshot byte-for-byte as well.
canyon/** -text -whitespace
# Ensure our Markdown/JSON audit metadata in canyon/ stays UTF-8 text.
canyon/CANYON-AUDIT.md text eol=lf
canyon/canyon-manifest.json text eol=lf
# Initial working copy is also byte-preserving; modified files have explicit diffs.
src/RedMoon.*/** -text

# Windows entrypoint bytes must be identical in packaging and native tests.
/*.cmd -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/setup/*.ps1 -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve the SHA-verified CI evidence bytes, including native Windows CRLF.
/audit/evidence/launcher-2026-10-29/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Relocated upstream legal/reference documents stay byte-identical on Windows too.
/licenses/FoxConquer5517-MIT.txt -text
/docs/reference/UPSTREAM-README.md -text
/docs/reference/UPSTREAM-TODO.md -text
/audit/evidence/layout-2026-10-30/** -text
