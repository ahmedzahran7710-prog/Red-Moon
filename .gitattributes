# Preserve imported and patched MoonQueen (CanyonV6192-derived) files byte-for-byte (UTF-8 BOMs and exact line endings).
src/** -text -whitespace
RequiredAssetsForRun/** -text -whitespace
.vscode/** -text -whitespace
/.editorconfig -text -whitespace
/.gitlab-ci.yml -text -whitespace
/MoonQueen.sln -text -whitespace
/LICENSE -text -whitespace
/dockerfile -text -whitespace
/wait-for-it.sh -text -whitespace

# Preserve imported and patched MoonQueen client loader files byte-for-byte inside the client loader folder.
"/لورد الكلينت/**" -text -whitespace

# Keep project governance, guides, manifests, and templates as clean UTF-8 LF text.
/.gitattributes text eol=lf
/.gitignore text eol=lf
/AGENTS.md text eol=lf
/README.md text eol=lf
/CANYON-AUDIT.md text eol=lf
/canyon-manifest.json text eol=lf
"/متطلبات التشغيل.md" text eol=lf
/ميموري.md text eol=lf
"/لورد الكلينت/README.md" text eol=lf
"/لورد الكلينت/config.json" text eol=lf
"/لورد الكلينت/loader-manifest.json" text eol=lf
"/موقع السيرفر/**/*.php" text eol=lf
"/موقع السيرفر/**/*.css" text eol=lf
"/موقع السيرفر/**/*.js" text eol=lf
"/موقع السيرفر/**/*.md" text eol=lf
"/موقع السيرفر/.htaccess" text eol=lf
"/موقع السيرفر/cache/.htaccess" text eol=lf
"/موقع السيرفر/**/*.jpg" binary
"/لوحة تحكم السيرفر/**/*.php" text eol=lf
"/لوحة تحكم السيرفر/**/*.css" text eol=lf
"/لوحة تحكم السيرفر/**/*.js" text eol=lf
"/لوحة تحكم السيرفر/**/*.md" text eol=lf
"/لوحة تحكم السيرفر/**/*.json" text eol=lf
"/لوحة تحكم السيرفر/.htaccess" text eol=lf
"/لوحة تحكم السيرفر/*.bat" text eol=crlf
"/تشغيل السيرفر/*.ps1" -text -whitespace
"/تشغيل السيرفر/*.bat" text eol=crlf
"/تشغيل السيرفر/*.md" text eol=lf
